{
  "name": "devpulse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @devpulse/database prisma:generate",
    "db:migrate:dev": "pnpm --filter @devpulse/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @devpulse/database db:migrate:deploy",
    "db:push": "pnpm --filter @devpulse/database db:push",
    "db:studio": "pnpm --filter @devpulse/database db:studio",
    "db:seed": "pnpm --filter @devpulse/database db:seed"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
