// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum RepositoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
  PENDING
}

enum ActivityEventType {
  PUSH
  PULL_REQUEST_OPENED
  PULL_REQUEST_CLOSED
  PULL_REQUEST_MERGED
  PULL_REQUEST_REOPENED
  PULL_REQUEST_REVIEW
  ISSUE_OPENED
  ISSUE_CLOSED
  RELEASE_PUBLISHED
  OTHER
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(MEMBER)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  githubAccounts  GitHubAccount[]
  authoredCommits Commit[]          @relation("CommitAuthorUser")
  pullRequests    PullRequest[]     @relation("PullRequestAuthorUser")
  reviews         Review[]          @relation("ReviewAuthorUser")
  activityEvents  ActivityEvent[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      WorkspaceMember[]
  repositories Repository[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        UserRole @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model GitHubAccount {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  githubUserId   BigInt    @unique @map("github_user_id")
  username       String
  displayName    String?   @map("display_name")
  email          String?
  avatarUrl      String?   @map("avatar_url")
  profileUrl     String?   @map("profile_url")
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  scopes         String[]  @default([])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@map("github_accounts")
}

model Repository {
  id            String           @id @default(uuid())
  workspaceId   String           @map("workspace_id")
  name          String
  fullName      String           @map("full_name")
  githubId      BigInt           @unique @map("github_id")
  description   String?
  url           String
  defaultBranch String           @default("main") @map("default_branch")
  isPrivate     Boolean          @default(false) @map("is_private")
  isFork        Boolean          @default(false) @map("is_fork")
  status        RepositoryStatus @default(ACTIVE)
  pushedAt      DateTime?        @map("pushed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commits        Commit[]
  pullRequests   PullRequest[]
  activityEvents ActivityEvent[]

  @@index([workspaceId])
  @@index([fullName])
  @@index([status])
  @@map("repositories")
}

model Commit {
  id             String    @id @default(uuid())
  repositoryId   String    @map("repository_id")
  sha            String
  message        String
  authorName     String    @map("author_name")
  authorEmail    String    @map("author_email")
  authorDate     DateTime  @map("author_date")
  committerName  String?   @map("committer_name")
  committerEmail String?   @map("committer_email")
  committerDate  DateTime? @map("committer_date")
  authorUserId   String?   @map("author_user_id")
  url            String?
  additions      Int       @default(0)
  deletions      Int       @default(0)
  totalChanges   Int       @default(0) @map("total_changes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  authorUser User?      @relation("CommitAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, sha])
  @@index([repositoryId])
  @@index([authorUserId])
  @@index([authorEmail])
  @@index([authorDate])
  @@index([sha])
  @@map("commits")
}

model PullRequest {
  id             String           @id @default(uuid())
  repositoryId   String           @map("repository_id")
  githubId       BigInt           @unique @map("github_id")
  number         Int
  title          String
  body           String?
  state          PullRequestState @default(OPEN)
  authorUsername String           @map("author_username")
  authorUserId   String?          @map("author_user_id")
  sourceBranch   String           @map("source_branch")
  targetBranch   String           @map("target_branch")
  isDraft        Boolean          @default(false) @map("is_draft")
  isMerged       Boolean          @default(false) @map("is_merged")
  url            String?
  additions      Int              @default(0)
  deletions      Int              @default(0)
  changedFiles   Int              @default(0) @map("changed_files")
  mergedAt       DateTime?        @map("merged_at")
  closedAt       DateTime?        @map("closed_at")
  githubCreatedAt DateTime        @map("github_created_at")
  githubUpdatedAt DateTime        @map("github_updated_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  authorUser User?      @relation("PullRequestAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  reviews    Review[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorUserId])
  @@index([state])
  @@index([authorUsername])
  @@index([createdAt])
  @@map("pull_requests")
}

model Review {
  id             String      @id @default(uuid())
  pullRequestId  String      @map("pull_request_id")
  githubId       BigInt      @unique @map("github_id")
  authorUsername String      @map("author_username")
  authorUserId   String?     @map("author_user_id")
  state          ReviewState
  body           String?
  commitSha      String?     @map("commit_sha")
  url            String?
  submittedAt    DateTime?   @map("submitted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  authorUser  User?       @relation("ReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([pullRequestId])
  @@index([authorUserId])
  @@index([state])
  @@index([authorUsername])
  @@index([submittedAt])
  @@map("reviews")
}

model ActivityEvent {
  id             String            @id @default(uuid())
  repositoryId   String?           @map("repository_id")
  userId         String?           @map("user_id")
  githubDelivery String?           @unique @map("github_delivery")
  eventType      ActivityEventType @map("event_type")
  action         String?
  actorUsername  String            @map("actor_username")
  payload        Json
  occurredAt     DateTime          @map("occurred_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([userId])
  @@index([eventType])
  @@index([actorUsername])
  @@index([occurredAt])
  @@map("activity_events")
}
