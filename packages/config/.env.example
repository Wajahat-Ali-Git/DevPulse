# ==========================================
# DevPulse Shared Package Configuration Example
# ==========================================

NODE_ENV=development
PORT=3000
WORKER_PORT=3002
LOG_LEVEL=info

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devpulse
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/devpulse

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

GITHUB_CLIENT_ID=dev_github_client_id
GITHUB_CLIENT_SECRET=dev_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=dev_github_webhook_secret

JWT_SECRET=devpulse_super_secret_jwt_key_32bytes!
JWT_EXPIRES_IN=7d
SESSION_SECRET=devpulse_super_secret_session_key_32bytes!

ENCRYPTION_KEY=devpulse_32byte_encryption_key_123!

WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
WORKER_URL=http://localhost:3002
